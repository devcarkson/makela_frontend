# Apache/cPanel config for the built SPA.
# Render ignores this file (see render.yaml); Netlify ignores it (see _redirects).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files (hashed assets, favicons, robots.txt) untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route -> index.html.
  RewriteRule ^ /index.html [L]
</IfModule>

# index.html must stay revalidated so new deploys are picked up.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Vite asset filenames are content-hashed, so they can be cached indefinitely.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>